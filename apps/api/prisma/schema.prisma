generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum EmailActionType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  firstName       String    @default("")
  lastName        String    @default("")
  avatar          String    @default("")
  avatarManuallySet Boolean @default(false)
  userName        String    @unique
  emailVerifiedAt DateTime?
  blockedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships Membership[]
  createdAccounts Account[] @relation("AccountCreatedBy")
  createdHaikus Haiku[] @relation("HaikuCreatedBy")
  shareLinks   ShareLink[]
  authIdentities AuthIdentity[]
  passwordCredential PasswordCredential?
  authSessions AuthSession[]
  emailActionTokens EmailActionToken[]
  emailChangeRequests UserEmailChangeRequest[]
}

model UserEmailChangeRequest {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  oldEmail      String
  newEmail      String
  tokenHash     String   @unique
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  sentAt        DateTime?
  consumedAt    DateTime?
  invalidatedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([expiresAt])
}

/// Tracks failed password login attempts for rate limiting (per normalized email, rolling window).
model FailedLoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  emailKey  String
  createdAt DateTime @default(now())

  @@index([emailKey, createdAt])
}

model Account {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  createdAt       DateTime @default(now())
  createdByUserId String?  @db.Uuid

  createdBy User? @relation("AccountCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  memberships Membership[]
  haikus      Haiku[]
  labels      Label[]

  @@index([createdByUserId])
}

model Membership {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  accountId String      @db.Uuid
  role      AccountRole @default(MEMBER)
  createdAt DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([userId])
  @@index([accountId])
  @@index([accountId, role])
  @@index([userId, role, createdAt])
}

model Haiku {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  titleSuffix Int      @default(0)
  body        String
  createdAt   DateTime @default(now())

  accountId   String   @db.Uuid
  createdById String   @db.Uuid

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User    @relation("HaikuCreatedBy", fields: [createdById], references: [id])

  labels     Label[]
  shareLinks ShareLink[]

  @@unique([accountId, title, titleSuffix])
  @@index([accountId])
  @@index([createdById])
  @@index([accountId, createdAt])
  @@index([createdAt(sort: Desc)])
  @@index([accountId, title, titleSuffix(sort: Desc)])
}

model ShareLink {
  id              String    @id @default(uuid()) @db.Uuid
  shareHash       String    @unique
  createdByUserId String    @db.Uuid
  sharedHaikuId   String    @db.Uuid
  haikuSubject    String
  expirationDate  DateTime?
  maxViews        Int?
  viewCount       Int       @default(0)
  createdAt       DateTime  @default(now())

  createdBy User  @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  haiku     Haiku @relation(fields: [sharedHaikuId], references: [id], onDelete: Cascade)

  @@index([createdByUserId])
  @@index([createdAt])
  @@index([createdByUserId, createdAt(sort: Desc)])
  @@index([createdByUserId, haikuSubject])
}

model Label {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  color     String   @default("default")
  createdAt DateTime @default(now())

  accountId String   @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  haikus Haiku[]

  @@unique([accountId, name])
  @@index([accountId])
  @@index([accountId, createdAt(sort: Desc)])
}

model AuthIdentity {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model PasswordCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id                String   @id @default(uuid()) @db.Uuid
  sessionId         String   @db.Uuid
  tokenHash         String   @unique
  parentTokenId     String?  @db.Uuid
  replacedByTokenId String?  @db.Uuid
  issuedAt          DateTime @default(now())
  expiresAt         DateTime
  consumedAt        DateTime?
  revokedAt         DateTime?
  reusedAt          DateTime?

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

model EmailActionToken {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @db.Uuid
  type          EmailActionType
  tokenHash     String          @unique
  createdAt     DateTime        @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  invalidatedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, type, usedAt, invalidatedAt])
  @@index([expiresAt])
}