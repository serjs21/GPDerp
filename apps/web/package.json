{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "dev:sanity": "pnpm build",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev": "concurrently -n next,ws -c auto \"pnpm dev:next\"",
    "lint": "eslint",
    "lint:complexity": "eslint src --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:playwright": "playwright test",
    "test:playwright:storybook-health": "playwright test tests/playwright/storybook-runtime-health.spec.ts",
    "infra-tests:jest": "jest infra-tests --runInBand",
    "infra-tests:storybook:build": "pnpm build-storybook",
    "infra-tests:storybook:health": "pnpm test:playwright:storybook-health",
    "infra-tests": "pnpm infra-tests:jest && pnpm infra-tests:storybook:build && pnpm infra-tests:storybook:health",
    "snapshots:auth-nav": "SNAPSHOT_AUTH_NAV=1 playwright test tests/playwright/auth-nav-hover-snapshots.spec.ts",
    "snapshots:auth-nav:expected": "node scripts/generate-auth-nav-expected-snapshots.mjs",
    "snapshots:auth-duality": "node scripts/capture-auth-duality-snapshots.mjs",
    "snapshots:auth-duality:hover": "node scripts/capture-auth-duality-hover-snapshots.mjs",
    "snapshots:auth-duality:animation": "node scripts/capture-auth-duality-animation-snapshots.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate-icons": "node scripts/generate-icons.mjs",
    "knip": "knip --production --include files,exports --no-exit-code",
    "knip:strict": "knip --production --include files,exports",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs --output-type err-long || true",
    "deps:check:strict": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "quality:check": "pnpm lint:complexity || true; pnpm knip; pnpm deps:check"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@base-ui/react": "^1.8.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@paddle/paddle-js": "^1.6.5",
    "@prisma/client": "^7.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@react-oauth/google": "^0.13.4",
    "@tanstack/react-query": "^5.96.2",
    "antd": "^6.1.4",
    "axios": "^1.13.2",
    "comicaljs": "^0.4.1",
    "country-flag-icons": "^1.6.16",
    "dayjs": "^1.11.13",
    "jose": "^6.2.2",
    "js-cookie": "^3.0.5",
    "lethargy-ts": "^0.1.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.8.0",
    "magic.css": "^1.4.8",
    "motion": "^12.34.3",
    "next": "16.3.3",
    "next-auth": "^4.24.13",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "openai": "^6.16.0",
    "react": "19.2.3",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "roughjs": "^4.6.6",
    "suncalc": "^2.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.2",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.1",
    "@storybook/addon-docs": "^10.3.1",
    "@storybook/addon-vitest": "^10.3.1",
    "@storybook/nextjs-vite": "^10.3.1",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/suncalc": "^1.9.2",
    "@types/ws": "^8.18.1",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "animejs": "^4.3.6",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "eslint-plugin-storybook": "^10.3.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "knip": "^6.9.0",
    "playwright": "^1.58.2",
    "prisma": "^7.2.0",
    "sharp": "^0.34.5",
    "storybook": "^10.3.1",
    "to-ico": "^1.1.5",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^8.0.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.1"
  }
}
