{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpderp-party",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild's keep_names wraps functions in `__name(...)`; next-themes serializes its pre-paint
  // theme function into the HTML, where `__name` doesn't exist ("ReferenceError: __name is not defined").
  "keep_names": false,
  "account_id": "6a315f2195d9aaf620d3cfc4d8d79d75",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gpderp-party"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Weekly usage totals (no personal data) written by /api/internal/usage-metrics.
  "analytics_engine_datasets": [
    {
      "binding": "USAGE_METRICS",
      "dataset": "gpderp_weekly_usage"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "gpderp.party",
      "custom_domain": true
    }
  ]
}
