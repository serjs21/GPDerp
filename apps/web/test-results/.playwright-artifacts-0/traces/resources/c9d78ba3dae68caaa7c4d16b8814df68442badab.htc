1c:["$","p","p-22",{"children":"Depending on where you live, you may have rights to:"}]
1d:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Access"}]," a copy of the personal information we hold about you"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Correct"}]," information that is inaccurate"]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Delete"}]," certain information, subject to legal exceptions"]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Object"}]," or ",["$","strong","strong-1",{"children":"restrict"}]," certain processing, where applicable"]}],"\n",["$","li","li-4",{"children":[["$","strong","strong-0",{"children":"Withdraw consent"}]," where processing is based on consent"]}],"\n",["$","li","li-5",{"children":[["$","strong","strong-0",{"children":"Lodge a complaint"}]," with a data protection authority in your region"]}],"\n"]}]
1e:["$","p","p-23",{"children":"To exercise these rights, contact us using the method at the end of this Policy. We will respond within a reasonable time. We may need to verify your identity before acting on a request."}]
1f:["$","p","p-24",{"children":"If you are in the European Economic Area, the United Kingdom, or similar regions, you may have specific statutory rights; we aim to honor reasonable requests in line with applicable law. Nothing in this Policy promises a particular legal outcome in every case."}]
