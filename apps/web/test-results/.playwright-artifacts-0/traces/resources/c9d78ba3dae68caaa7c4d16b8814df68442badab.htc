6:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"Provide, maintain, and improve the Haiku generation service"}],"\n",["$","li","li-1",{"children":"Authenticate users and protect accounts"}],"\n",["$","li","li-2",{"children":"Process transactions and manage access tied to subscriptions or purchases"}],"\n",["$","li","li-3",{"children":"Send service-related messages (such as security notices, receipts, or responses to support)"}],"\n",["$","li","li-4",{"children":"Understand aggregate or basic usage patterns and fix technical issues"}],"\n",["$","li","li-5",{"children":"Comply with legal obligations and enforce our terms"}],"\n"]}]
7:["$","p","p-12",{"children":"We do not sell your personal information. We do not use your data to build aggressive cross-site advertising profiles through our own product."}]
8:["$","hr","hr-3",{}]
9:["$","h2","h2-3",{"children":"4. Legal bases (where they apply)"}]
a:["$","p","p-13",{"children":"Depending on where you live, laws such as the GDPR may require a â€œlegal basisâ€ for certain processing. In those cases, we generally rely on one or more of the following as appropriate: performing our contract with you (providing the Haiku generation service), legitimate interests that are not overridden by your rights (for example, securing the service and improving reliability), your consent where we ask for it, or compliance with legal obligations."}]
b:["$","p","p-14",{"children":"This Policy is not a complete legal analysis of every jurisdiction. If you have questions about how this applies to you, you may contact us using the details below."}]
c:["$","hr","hr-4",{}]
d:["$","h2","h2-4",{"children":"5. Third-party services"}]
e:["$","p","p-15",{"children":"We use service providers that help us run the Haiku generation service. They process information on our behalf according to their roles and their own terms and privacy notices. Examples may include:"}]
f:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Paddle"}]," â€” payment processing and related checkout, tax, and invoicing as merchant of record"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Hosting, email, and infrastructure"}]," â€” storing data and delivering the application"]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Authentication providers"}]," â€” if you choose to sign in through a third party"]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Analytics"}]," â€” basic measurement of traffic or product usage, configured to stay proportionate to our needs"]}],"\n"]}]
10:["$","p","p-16",{"children":"We encourage you to read the privacy policies of providers you interact with directly (especially at checkout with Paddle)."}]
11:["$","hr","hr-5",{}]
12:["$","h2","h2-5",{"children":"6. Cookies and similar technologies"}]
13:["$","p","p-17",{"children":"We may use cookies, local storage, or similar technologies to keep you signed in, remember preferences, protect against abuse, and support basic analytics. You can control many cookies through your browser settings; blocking some cookies may limit certain features (for example, staying logged in)."}]
14:["$","p","p-18",{"children":"We do not use cookies in complicated or hidden ways beyond what is typical for a small authenticated web application and proportionate analytics."}]
15:["$","p","p-19",{"children":["For a dedicated overview, see our ",["$","a","a-0",{"href":"/cookies","children":"Cookie Policy"}],"."]}]
16:["$","hr","hr-6",{}]
17:["$","h2","h2-6",{"children":"7. How long we keep information"}]
18:["$","p","p-20",{"children":"We retain information only as long as needed for the purposes described in this Policy, unless a longer period is required or permitted by law (for example, tax or accounting records handled by Paddle or our tools). When data is no longer needed, we delete or anonymize it where feasible, subject to technical limits and backups."}]
19:["$","p","p-21",{"children":"Exact retention periods can vary by data type and legal context; if you want more detail about your own data, contact us."}]
