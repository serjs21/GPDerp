        "ArnLike": { "aws:PrincipalArn": "arn:aws:iam::267950238053:role/*AccountFullAccessRole" },
        "StringEquals": { "aws:PrincipalOrgID": "o-4uj1odpsdw" }
      }
    }
  ]
}
