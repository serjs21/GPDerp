{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeFromGpderpMemberAccountRole",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::267950238053:root" },
      "Action": ["sts:AssumeRole", "sts:SetSourceIdentity"],
