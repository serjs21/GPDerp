{
  "$comment": "Runtime environment of the `api` container. `defaults` apply when a value is not provided (and are kept from the current deployment otherwise). Only names listed here (or in defaults) are sent to Lightsail; values are never printed.",
  "defaults": {
    "NODE_ENV": "production",
    "PORT": "8080",
    "TRUST_PROXY_HOPS": "1",
    "NODE_OPTIONS": "--max-old-space-size=512",
    "COOKIE_SECURE": "true",
    "COOKIE_SAME_SITE": "lax",
    "DEBUG_AUTH_LOGS": "false",
    "HAIKU_GENERATION_API": "prod"
  },
  "variables": [
    { "name": "DATABASE_URL", "required": true, "secret": true, "description": "Neon pooled connection (-pooler host), Prisma runtime" },
    { "name": "DATABASE_URL_UNPOOLED", "required": true, "secret": true, "description": "Neon direct connection, pg-boss" },
    { "name": "CLIENT_URL", "required": true, "secret": false, "description": "Web origin(s) allowed by CORS and the WebSocket Origin check" },
    { "name": "WEB_APP_URL", "required": true, "secret": false, "description": "Links in emails" },
    { "name": "API_BASE_URL", "required": true, "secret": false, "description": "Public API URL" },
    { "name": "COOKIE_DOMAIN", "required": true, "secret": false, "description": "e.g. .gpderp.party" },
    { "name": "JWT_ACCESS_SECRET", "required": true, "secret": true, "description": "At least 32 characters" },
    { "name": "TOKEN_HASH_PEPPER", "required": true, "secret": true, "description": "At least 16 characters" },
    { "name": "ACCESS_TOKEN_TTL_SECONDS", "required": true, "secret": false, "description": "" },
    { "name": "REFRESH_TOKEN_TTL_SECONDS", "required": true, "secret": false, "description": "" },
    { "name": "SESSION_TTL_SECONDS", "required": true, "secret": false, "description": "" },
    { "name": "GOOGLE_CLIENT_ID", "required": false, "secret": false, "description": "Google sign-in" },
    { "name": "R2_ACCOUNT_ID", "required": true, "secret": false, "description": "" },
    { "name": "R2_ACCESS_KEY_ID", "required": true, "secret": true, "description": "" },
    { "name": "R2_SECRET_ACCESS_KEY", "required": true, "secret": true, "description": "" },
    { "name": "R2_BUCKET_NAME", "required": true, "secret": false, "description": "" },
    { "name": "R2_PUBLIC_BASE_URL", "required": true, "secret": false, "description": "" },
    { "name": "R2_REGION", "required": false, "secret": false, "description": "Default auto" },
    { "name": "R2_S3_ENDPOINT", "required": false, "secret": false, "description": "Default derived from R2_ACCOUNT_ID" },
    { "name": "PADDLE_API_KEY", "required": true, "secret": true, "description": "" },
    { "name": "PADDLE_WEBHOOK_SECRET", "required": true, "secret": true, "description": "" },
    { "name": "PADDLE_ENV", "required": true, "secret": false, "description": "sandbox or production" },
    { "name": "PADDLE_PRICE_ID_100_HAIKUS", "required": true, "secret": false, "description": "" },
    { "name": "SMTP_HOST", "required": true, "secret": false, "description": "Verification and postcard emails" },
    { "name": "SMTP_PORT", "required": true, "secret": false, "description": "" },
    { "name": "SMTP_SECURE", "required": false, "secret": false, "description": "Default false (STARTTLS on 587)" },
    { "name": "SMTP_USER", "required": true, "secret": false, "description": "" },
    { "name": "SMTP_PASS", "required": true, "secret": true, "description": "" },
    { "name": "MAIL_FROM", "required": true, "secret": false, "description": "" },
    { "name": "OPENAI_API_KEY", "required": true, "secret": true, "description": "Required while HAIKU_GENERATION_API=prod" },
    { "name": "CORS_METHODS", "required": false, "secret": false, "description": "" },
    { "name": "CORS_HEADERS", "required": false, "secret": false, "description": "" },
    { "name": "CORS_CREDENTIALS", "required": false, "secret": false, "description": "" },
    { "name": "ICON_UPLOAD_DEBUG", "required": false, "secret": false, "description": "" }
  ]
}
