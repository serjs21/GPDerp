# Lightsail deployment target (no secrets). Every value can be overridden from the environment,
# e.g. `AWS_PROFILE=gpderp LIGHTSAIL_SERVICE=... infra/aws/deploy.sh`.
# shellcheck shell=bash

: "${LIGHTSAIL_SERVICE:=container-service-1}"
: "${AWS_REGION:=us-east-2}"
: "${CONTAINER_NAME:=api}"
: "${IMAGE_LABEL:=api}"
: "${CONTAINER_PORT:=8080}"

# Preflight refuses to continue if the service differs (the tooling never resizes or creates services).
: "${EXPECTED_POWER:=micro}"
: "${EXPECTED_SCALE:=1}"
: "${EXPECTED_ACCOUNT_ID:=311883575175}"

# Local image repository name (tagged with the git SHA by build.sh).
: "${LOCAL_IMAGE_REPO:=gpderp-api}"

# Gitignored runtime env file for the first deployment / explicit config changes.
: "${RUNTIME_ENV_FILE:=apps/api/.env.lightsail}"

# Browser origin allowed by the API (Origin check on authenticated WebSocket handshakes).
: "${WEB_ORIGIN:=https://gpderp.party}"
